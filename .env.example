# Database Configuration
# Required: PostgreSQL database connection string

# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/freelance_pilot?schema=public"

# For production deployment on Vercel with Vercel Postgres:
# Vercel Postgres automatically provides this environment variable
# You can also manually set it in your Vercel project settings
# DATABASE_URL="postgres://default:***@***-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb"

# Alternative PostgreSQL providers:
# - Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres (Recommended for Vercel)
# - Supabase: https://supabase.com (Free tier available)
# - Neon: https://neon.tech (Serverless Postgres)
# - Railway: https://railway.app (Easy setup)

DATABASE_URL="postgresql://user:password@localhost:5432/freelance_pilot?schema=public"
